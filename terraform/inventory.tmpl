[dev]
dev-server ansible_host=${dev_ip} ansible_user=ubuntu ansible_ssh_private_key_file=./devops-key.pem ansible_ssh_common_args='-o StrictHostKeyChecking=no'

[prod]
prod-server ansible_host=${prod_ip} ansible_user=ubuntu ansible_ssh_private_key_file=./devops-key.pem ansible_ssh_common_args='-o StrictHostKeyChecking=no'